{
  "sections": [
    {
      "id": "opening",
      "verses": [
        {
          "id": 1,
          "first": "मातु लक्ष्मी करि कृपा, करो हृदय में वास",
          "second": "मनोकामना सिद्ध करि, परुवहु मेरी आस"
        }
      ]
    },
    {
      "id": "sortha",
      "verses": [
        {
          "id": 2,
          "first": "यही मोर अरदास, हाथ जोड़ विनती करुं",
          "second": "सब विधि करौ सुवास, जय जननि जगदम्बिका"
        }
      ]
    },
    {
      "id": "chaupai",
      "verses": [
        {
          "id": 3,
          "first": "सिन्धु सुता मैं सुमिरौ तोही",
          "second": "ज्ञान, बुद्धि, विद्या दो मोही"
        },
        {
          "id": 4,
          "first": "तुम समान नहिं कोई उपकारी",
          "second": "सब विधि पुरवहु आस हमारी"
        },
        {
          "id": 5,
          "first": "जय जय जगत जननि जगदम्बा",
          "second": "सबकी तुम ही हो अवलम्बा"
        },
        {
          "id": 6,
          "first": "तुम ही हो सब घट घट वासी",
          "second": "विनती यही हमारी खासी"
        },
        {
          "id": 7,
          "first": "जगजननी जय सिन्धु कुमारी",
          "second": "दीनन की तुम हो हितकारी"
        },
        {
          "id": 8,
          "first": "विनवौं नित्य तुमहिं महारानी",
          "second": "कृपा करौ जग जननि भवानी"
        },
        {
          "id": 9,
          "first": "केहि विधि स्तुति करौं तिहारी",
          "second": "सुधि लीजै अपराध बिसारी"
        },
        {
          "id": 10,
          "first": "कृपा दृष्टि चितववो मम ओरी",
          "second": "जगजननी विनती सुन मोरी"
        },
        {
          "id": 11,
          "first": "ज्ञान बुद्धि जय सुख की दाता",
          "second": "संकट हरो हमारी माता"
        },
        {
          "id": 12,
          "first": "क्षीरसिन्धु जब विष्णु मथायो",
          "second": "चौदह रत्न सिन्धु में पायो"
        },
        {
          "id": 13,
          "first": "चौदह रत्न में तुम सुखरासी",
          "second": "सेवा कियो प्रभु बनि दासी"
        },
        {
          "id": 14,
          "first": "जब जब जन्म जहां प्रभु लीन्हा",
          "second": "रुप बदल तहं सेवा कीन्हा"
        },
        {
          "id": 15,
          "first": "स्वयं विष्णु जब नर तनु धारा",
          "second": "लीन्हेउ अवधपुरी अवतारा"
        },
        {
          "id": 16,
          "first": "तब तुम प्रगट जनकपुर माहीं",
          "second": "सेवा कियो हृदय पुलकाहीं"
        },
        {
          "id": 17,
          "first": "अपनाया तोहि अन्तर्यामी",
          "second": "विश्व विदित त्रिभुवन की स्वामी"
        },
        {
          "id": 18,
          "first": "तुम सम प्रबल शक्ति नहीं आनी",
          "second": "कहं लौ महिमा कहौं बखानी"
        },
        {
          "id": 19,
          "first": "मन क्रम वचन करै सेवकाई",
          "second": "मन इच्छित वाञ्छित फल पाई"
        },
        {
          "id": 20,
          "first": "तजि छल कपट और चतुराई",
          "second": "पूजहिं विविध भाँति मनलाई"
        },
        {
          "id": 21,
          "first": "और हाल मैं कहौं बुझाई",
          "second": "जो यह पाठ करै मन लाई"
        },
        {
          "id": 22,
          "first": "ताको कोई कष्ट नोई",
          "second": "मन इच्छित पावै फल सोई"
        },
        {
          "id": 23,
          "first": "त्राहि त्राहि जय दुःख निवारिणि",
          "second": "त्रिविध ताप भव बन्धन हारिणी"
        },
        {
          "id": 24,
          "first": "जो चालीसा पढ़ै पढ़ावै",
          "second": "ध्यान लगाकर सुनै सुनावै"
        },
        {
          "id": 25,
          "first": "ताकौ कोई न रोग सतावै",
          "second": "पुत्र आदि धन सम्पत्ति पावै"
        },
        {
          "id": 26,
          "first": "पुत्रहीन अरु सम्पति हीना",
          "second": "अन्ध बधिर कोढ़ी अति दीना"
        },
        {
          "id": 27,
          "first": "विप्र बोलाय कै पाठ करावै",
          "second": "शंका दिल में कभी न लावै"
        },
        {
          "id": 28,
          "first": "पाठ करावै दिन चालीसा",
          "second": "ता पर कृपा करैं गौरीसा"
        },
        {
          "id": 29,
          "first": "सुख सम्पत्ति बहुत सी पावै",
          "second": "कमी नहीं काहू की आवै"
        },
        {
          "id": 30,
          "first": "बारह मास करै जो पूजा",
          "second": "तेहि सम धन्य और नहिं दूजा"
        },
        {
          "id": 31,
          "first": "प्रतिदिन पाठ करै मन माही",
          "second": "उन सम कोइ जग में कहुं नाहीं"
        },
        {
          "id": 32,
          "first": "बहुविधि क्या मैं करौं बड़ाई",
          "second": "लेय परीक्षा ध्यान लगाई"
        },
        {
          "id": 33,
          "first": "करि विश्वास करै व्रत नेमा",
          "second": "होय सिद्ध उपजै उर प्रेमा"
        },
        {
          "id": 34,
          "first": "जय जय जय लक्ष्मी भवानी",
          "second": "सब में व्यापित हो गुण खानी"
        },
        {
          "id": 35,
          "first": "तुम्हरो तेज प्रबल जग माहीं",
          "second": "तुम सम कोउ दयालु कहुं नाहिं"
        },
        {
          "id": 36,
          "first": "मोहि अनाथ की सुधि अब लीजै",
          "second": "संकट काटि भक्ति मोहि दीजै"
        },
        {
          "id": 37,
          "first": "भूल चूक करि क्षमा हमारी",
          "second": "दर्शन दजै दशा निहारी"
        },
        {
          "id": 38,
          "first": "बिन दर्शन व्याकुल अधिकारी",
          "second": "तुमहि अछत दुःख सहते भारी"
        },
        {
          "id": 39,
          "first": "नहिं मोहिं ज्ञान बुद्धि है तन में",
          "second": "सब जानत हो अपने मन में"
        },
        {
          "id": 40,
          "first": "रुप चतुर्भुज करके धारण",
          "second": "कष्ट मोर अब करहु निवारण"
        },
        {
          "id": 41,
          "first": "केहि प्रकार मैं करौं बड़ाई",
          "second": "ज्ञान बुद्धि मोहि नहिं अधिकाई"
        }
      ]
    },
    {
      "id": "closing",
      "verses": [
        {
          "id": 42,
          "first": "त्राहि त्राहि दुःख हारिणी, हरो वेगि सब त्रास",
          "second": "जयति जयति जय लक्ष्मी, करो शत्रु को नाश"
        },
        {
          "id": 43,
          "first": "रामदास धरि ध्यान नित, विनय करत कर जोर",
          "second": "मातु लक्ष्मी दास पर, करहु दया की कोर"
        }
      ]
    }
  ]
}
