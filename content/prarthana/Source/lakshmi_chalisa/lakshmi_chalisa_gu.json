{
  "sections": [
    {
      "id": "opening",
      "verses": [
        {
          "id": 1,
          "first": "માતુ લક્ષ્મી કરિ કૃપા, કરો હૃદય મેં વાસ",
          "second": "મનોકામના સિદ્ધ કરિ, પરુવહુ મેરી આસ"
        }
      ]
    },
    {
      "id": "sortha",
      "verses": [
        {
          "id": 2,
          "first": "યહી મોર અરદાસ, હાથ જોડ઼ વિનતી કરું",
          "second": "સબ વિધિ કરૌ સુવાસ, જય જનનિ જગદમ્બિકા"
        }
      ]
    },
    {
      "id": "chaupai",
      "verses": [
        {
          "id": 3,
          "first": "સિન્ધુ સુતા મૈં સુમિરૌ તોહી",
          "second": "જ્ઞાન, બુદ્ધિ, વિદ્યા દો મોહી"
        },
        {
          "id": 4,
          "first": "તુમ સમાન નહિં કોઈ ઉપકારી",
          "second": "સબ વિધિ પુરવહુ આસ હમારી"
        },
        {
          "id": 5,
          "first": "જય જય જગત જનનિ જગદમ્બા",
          "second": "સબકી તુમ હી હો અવલમ્બા"
        },
        {
          "id": 6,
          "first": "તુમ હી હો સબ ઘટ ઘટ વાસી",
          "second": "વિનતી યહી હમારી ખાસી"
        },
        {
          "id": 7,
          "first": "જગજનની જય સિન્ધુ કુમારી",
          "second": "દીનન કી તુમ હો હિતકારી"
        },
        {
          "id": 8,
          "first": "વિનવૌં નિત્ય તુમહિં મહારાની",
          "second": "કૃપા કરૌ જગ જનનિ ભવાની"
        },
        {
          "id": 9,
          "first": "કેહિ વિધિ સ્તુતિ કરૌં તિહારી",
          "second": "સુધિ લીજૈ અપરાધ બિસારી"
        },
        {
          "id": 10,
          "first": "કૃપા દૃષ્ટિ ચિતવવો મમ ઓરી",
          "second": "જગજનની વિનતી સુન મોરી"
        },
        {
          "id": 11,
          "first": "જ્ઞાન બુદ્ધિ જય સુખ કી દાતા",
          "second": "સંકટ હરો હમારી માતા"
        },
        {
          "id": 12,
          "first": "ક્ષીરસિન્ધુ જબ વિષ્ણુ મથાયો",
          "second": "ચૌદહ રત્ન સિન્ધુ મેં પાયો"
        },
        {
          "id": 13,
          "first": "ચૌદહ રત્ન મેં તુમ સુખરાસી",
          "second": "સેવા કિયો પ્રભુ બનિ દાસી"
        },
        {
          "id": 14,
          "first": "જબ જબ જન્મ જહાં પ્રભુ લીન્હા",
          "second": "રુપ બદલ તહં સેવા કીન્હા"
        },
        {
          "id": 15,
          "first": "સ્વયં વિષ્ણુ જબ નર તનુ ધારા",
          "second": "લીન્હેઉ અવધપુરી અવતારા"
        },
        {
          "id": 16,
          "first": "તબ તુમ પ્રગટ જનકપુર માહીં",
          "second": "સેવા કિયો હૃદય પુલકાહીં"
        },
        {
          "id": 17,
          "first": "અપનાયા તોહિ અન્તર્યામી",
          "second": "વિશ્વ વિદિત ત્રિભુવન કી સ્વામી"
        },
        {
          "id": 18,
          "first": "તુમ સમ પ્રબલ શક્તિ નહીં આની",
          "second": "કહં લૌ મહિમા કહૌં બખાની"
        },
        {
          "id": 19,
          "first": "મન ક્રમ વચન કરૈ સેવકાઈ",
          "second": "મન ઇચ્છિત વાઞ્છિત ફલ પાઈ"
        },
        {
          "id": 20,
          "first": "તજિ છલ કપટ ઔર ચતુરાઈ",
          "second": "પૂજહિં વિવિધ ભાઁતિ મનલાઈ"
        },
        {
          "id": 21,
          "first": "ઔર હાલ મૈં કહૌં બુઝાઈ",
          "second": "જો યહ પાઠ કરૈ મન લાઈ"
        },
        {
          "id": 22,
          "first": "તાકો કોઈ કષ્ટ નોઈ",
          "second": "મન ઇચ્છિત પાવૈ ફલ સોઈ"
        },
        {
          "id": 23,
          "first": "ત્રાહિ ત્રાહિ જય દુઃખ નિવારિણિ",
          "second": "ત્રિવિધ તાપ ભવ બન્ધન હારિણી"
        },
        {
          "id": 24,
          "first": "જો ચાલીસા પઢ઼ૈ પઢ઼ાવૈ",
          "second": "ધ્યાન લગાકર સુનૈ સુનાવૈ"
        },
        {
          "id": 25,
          "first": "તાકૌ કોઈ ન રોગ સતાવૈ",
          "second": "પુત્ર આદિ ધન સમ્પત્તિ પાવૈ"
        },
        {
          "id": 26,
          "first": "પુત્રહીન અરુ સમ્પતિ હીના",
          "second": "અન્ધ બધિર કોઢ઼ી અતિ દીના"
        },
        {
          "id": 27,
          "first": "વિપ્ર બોલાય કૈ પાઠ કરાવૈ",
          "second": "શંકા દિલ મેં કભી ન લાવૈ"
        },
        {
          "id": 28,
          "first": "પાઠ કરાવૈ દિન ચાલીસા",
          "second": "તા પર કૃપા કરૈં ગૌરીસા"
        },
        {
          "id": 29,
          "first": "સુખ સમ્પત્તિ બહુત સી પાવૈ",
          "second": "કમી નહીં કાહૂ કી આવૈ"
        },
        {
          "id": 30,
          "first": "બારહ માસ કરૈ જો પૂજા",
          "second": "તેહિ સમ ધન્ય ઔર નહિં દૂજા"
        },
        {
          "id": 31,
          "first": "પ્રતિદિન પાઠ કરૈ મન માહી",
          "second": "ઉન સમ કોઇ જગ મેં કહું નાહીં"
        },
        {
          "id": 32,
          "first": "બહુવિધિ ક્યા મૈં કરૌં બડ઼ાઈ",
          "second": "લેય પરીક્ષા ધ્યાન લગાઈ"
        },
        {
          "id": 33,
          "first": "કરિ વિશ્વાસ કરૈ વ્રત નેમા",
          "second": "હોય સિદ્ધ ઉપજૈ ઉર પ્રેમા"
        },
        {
          "id": 34,
          "first": "જય જય જય લક્ષ્મી ભવાની",
          "second": "સબ મેં વ્યાપિત હો ગુણ ખાની"
        },
        {
          "id": 35,
          "first": "તુમ્હરો તેજ પ્રબલ જગ માહીં",
          "second": "તુમ સમ કોઉ દયાલુ કહું નાહિં"
        },
        {
          "id": 36,
          "first": "મોહિ અનાથ કી સુધિ અબ લીજૈ",
          "second": "સંકટ કાટિ ભક્તિ મોહિ દીજૈ"
        },
        {
          "id": 37,
          "first": "ભૂલ ચૂક કરિ ક્ષમા હમારી",
          "second": "દર્શન દજૈ દશા નિહારી"
        },
        {
          "id": 38,
          "first": "બિન દર્શન વ્યાકુલ અધિકારી",
          "second": "તુમહિ અછત દુઃખ સહતે ભારી"
        },
        {
          "id": 39,
          "first": "નહિં મોહિં જ્ઞાન બુદ્ધિ હૈ તન મેં",
          "second": "સબ જાનત હો અપને મન મેં"
        },
        {
          "id": 40,
          "first": "રુપ ચતુર્ભુજ કરકે ધારણ",
          "second": "કષ્ટ મોર અબ કરહુ નિવારણ"
        },
        {
          "id": 41,
          "first": "કેહિ પ્રકાર મૈં કરૌં બડ઼ાઈ",
          "second": "જ્ઞાન બુદ્ધિ મોહિ નહિં અધિકાઈ"
        }
      ]
    },
    {
      "id": "closing",
      "verses": [
        {
          "id": 42,
          "first": "ત્રાહિ ત્રાહિ દુઃખ હારિણી, હરો વેગિ સબ ત્રાસ",
          "second": "જયતિ જયતિ જય લક્ષ્મી, કરો શત્રુ કો નાશ"
        },
        {
          "id": 43,
          "first": "રામદાસ ધરિ ધ્યાન નિત, વિનય કરત કર જોર",
          "second": "માતુ લક્ષ્મી દાસ પર, કરહુ દયા કી કોર"
        }
      ]
    }
  ]
}
