{
  "sections": [
    {
      "id": "opening",
      "verses": [
        {
          "id": 1,
          "first": "જય ગણપતિ સદગુણ સદન, કવિવર બદન કૃપાલ",
          "second": "વિઘ્ન હરણ મંગલ કરણ, જય જય ગિરિજાલાલ"
        }
      ]
    },
    {
      "id": "chaupai",
      "verses": [
        {
          "id": 2,
          "first": "જય જય જય ગણપતિ ગણરાજૂ",
          "second": "મંગલ ભરણ કરણ શુભઃ કાજૂ"
        },
        {
          "id": 3,
          "first": "જૈ ગજબદન સદન સુખદાતા",
          "second": "વિશ્વ વિનાયકા બુદ્ધિ વિધાતા"
        },
        {
          "id": 4,
          "first": "વક્ર તુણ્ડ શુચી શુણ્ડ સુહાવના",
          "second": "તિલક ત્રિપુણ્ડ ભાલ મન ભાવન"
        },
        {
          "id": 5,
          "first": "રાજત મણિ મુક્તન ઉર માલા",
          "second": "સ્વર્ણ મુકુટ શિર નયન વિશાલા"
        },
        {
          "id": 6,
          "first": "પુસ્તક પાણિ કુઠાર ત્રિશૂલં",
          "second": "મોદક ભોગ સુગન્ધિત ફૂલં"
        },
        {
          "id": 7,
          "first": "સુન્દર પીતામ્બર તન સાજિત",
          "second": "ચરણ પાદુકા મુનિ મન રાજિત"
        },
        {
          "id": 8,
          "first": "ધનિ શિવ સુવન ષડાનન ભ્રાતા",
          "second": "ગૌરી લાલન વિશ્વ-વિખ્યાતા"
        },
        {
          "id": 9,
          "first": "ઋદ્ધિ-સિદ્ધિ તવ ચંવર સુધારે",
          "second": "મુષક વાહન સોહત દ્વારે"
        },
        {
          "id": 10,
          "first": "કહૌ જન્મ શુભ કથા તુમ્હારી",
          "second": "અતિ શુચી પાવન મંગલકારી"
        },
        {
          "id": 11,
          "first": "એક સમય ગિરિરાજ કુમારી",
          "second": "પુત્ર હેતુ તપ કીન્હા ભારી"
        },
        {
          "id": 12,
          "first": "ભયો યજ્ઞ જબ પૂર્ણ અનૂપા",
          "second": "તબ પહુંચ્યો તુમ ધરી દ્વિજ રૂપા"
        },
        {
          "id": 13,
          "first": "અતિથિ જાની કે ગૌરી સુખારી",
          "second": "બહુવિધિ સેવા કરી તુમ્હારી"
        },
        {
          "id": 14,
          "first": "અતિ પ્રસન્ન હવૈ તુમ વર દીન્હા",
          "second": "માતુ પુત્ર હિત જો તપ કીન્હા"
        },
        {
          "id": 15,
          "first": "મિલહિ પુત્ર તુહિ, બુદ્ધિ વિશાલા",
          "second": "બિના ગર્ભ ધારણ યહિ કાલા"
        },
        {
          "id": 16,
          "first": "ગણનાયક ગુણ જ્ઞાન નિધાના",
          "second": "પૂજિત પ્રથમ રૂપ ભગવાના"
        },
        {
          "id": 17,
          "first": "અસ કહી અન્તર્ધાન રૂપ હવૈ",
          "second": "પાલના પર બાલક સ્વરૂપ હવૈ"
        },
        {
          "id": 18,
          "first": "બનિ શિશુ રુદન જબહિં તુમ ઠાના",
          "second": "લખિ મુખ સુખ નહિં ગૌરી સમાના"
        },
        {
          "id": 19,
          "first": "સકલ મગન, સુખમંગલ ગાવહિં",
          "second": "નાભ તે સુરન, સુમન વર્ષાવહિં"
        },
        {
          "id": 20,
          "first": "શમ્ભુ, ઉમા, બહુદાન લુટાવહિં",
          "second": "સુર મુનિજન, સુત દેખન આવહિં"
        },
        {
          "id": 21,
          "first": "લખિ અતિ આનન્દ મંગલ સાજા",
          "second": "દેખન ભી આયે શનિ રાજા"
        },
        {
          "id": 22,
          "first": "નિજ અવગુણ ગુનિ શનિ મન માહીં",
          "second": "બાલક, દેખન ચાહત નાહીં"
        },
        {
          "id": 23,
          "first": "ગિરિજા કછુ મન ભેદ બઢાયો",
          "second": "ઉત્સવ મોર, ન શનિ તુહી ભાયો"
        },
        {
          "id": 24,
          "first": "કહત લગે શનિ, મન સકુચાઈ",
          "second": "કા કરિહૌ, શિશુ મોહિ દિખાઈ"
        },
        {
          "id": 25,
          "first": "નહિં વિશ્વાસ, ઉમા ઉર ભયઊ",
          "second": "શનિ સોં બાલક દેખન કહયઊ"
        },
        {
          "id": 26,
          "first": "પદતહિં શનિ દૃગ કોણ પ્રકાશા",
          "second": "બાલક સિર ઉड़િ ગયો અકાશા"
        },
        {
          "id": 27,
          "first": "ગિરિજા ગિરી વિકલ હવૈ ધરણી",
          "second": "સો દુઃખ દશા ગયો નહીં વરણી"
        },
        {
          "id": 28,
          "first": "હાહાકાર મચ્યૌ કૈલાશા",
          "second": "શનિ કીન્હોં લખિ સુત કો નાશા"
        },
        {
          "id": 29,
          "first": "તુરત ગરુड़ ચढ़િ વિષ્ણુ સિધાયો",
          "second": "કાટી ચક્ર સો ગજ સિર લાયે"
        },
        {
          "id": 30,
          "first": "બાલક કે ધડ઼ ઊપર ધારયો",
          "second": "પ્રાણ મન્ત્ર પढ़િ શંકર ડારયો"
        },
        {
          "id": 31,
          "first": "નામ ગણેશ શમ્ભુ તબ કીન્હે",
          "second": "પ્રથમ પૂજ્ય બુદ્ધિ નિધિ, વર દીન્હે"
        },
        {
          "id": 32,
          "first": "બુદ્ધિ પરીક્ષા જબ શિવ કીન્હા",
          "second": "પૃથ્વી કર પ્રદક્ષિણા લીન્હા"
        },
        {
          "id": 33,
          "first": "ચલે ષડાનન, ભરમિ ભુલાઈ",
          "second": "રચે બૈઠ તુમ બુદ્ધિ ઉપાઈ"
        },
        {
          "id": 34,
          "first": "ચરણ માતુ-પિતુ કે ધર લીન્હેં",
          "second": "તિનકે સાત પ્રદક્ષિણ કીન્હેં"
        },
        {
          "id": 35,
          "first": "ધનિ ગણેશ કહી શિવ હિયે હરષે",
          "second": "નભ તે સુરન સુમન બહુ બરસે"
        },
        {
          "id": 36,
          "first": "તુમ્હરી મહિમા બુદ્ધિ બड़ાઈ",
          "second": "શેષ સહસમુખ સકે ન ગાઈ"
        },
        {
          "id": 37,
          "first": "મૈં મતિહીન મલીન દુખારી",
          "second": "કરહૂં કૌન વિધિ વિનય તુમ્હારી"
        },
        {
          "id": 38,
          "first": "ભજત રામસુન્દર પ્રભુદાસા",
          "second": "જગ પ્રયાગ, કકરા, દુર્વાસા"
        },
        {
          "id": 39,
          "first": "અબ પ્રભુ દયા દીના પર કીજૈ",
          "second": "અપની શક્તિ ભક્તિ કુછ દીજૈ"
        }
      ]
    },
    {
      "id": "closing",
      "verses": [
        {
          "id": 40,
          "first": "શ્રી ગણેશ યહ ચાલીસા, પાઠ કરૈ કર ધ્યાન",
          "second": "નિત નવ મંગલ ગૃહ બસૈ, લહે જગત સન્માન"
        },
        {
          "id": 41,
          "first": "સમ્બન્ધ અપને સહસ્ર દશ, ઋષિ પંચમી દિનેશ",
          "second": "પૂરણ ચાલીસા ભયો, મંગલ મૂર્તી ગણેશ"
        }
      ]
    }
  ]
}
