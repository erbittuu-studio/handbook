{
  "sections": [
    {
      "id": "opening",
      "verses": [
        {
          "id": 1,
          "first": "जय गणपति सदगुण सदन, कविवर बदन कृपाल",
          "second": "विघ्न हरण मंगल करण, जय जय गिरिजालाल"
        }
      ]
    },
    {
      "id": "chaupai",
      "verses": [
        {
          "id": 2,
          "first": "जय जय जय गणपति गणराजू",
          "second": "मंगल भरण करण शुभः काजू"
        },
        {
          "id": 3,
          "first": "जै गजबदन सदन सुखदाता",
          "second": "विश्व विनायका बुद्धि विधाता"
        },
        {
          "id": 4,
          "first": "वक्र तुण्ड शुची शुण्ड सुहावना",
          "second": "तिलक त्रिपुण्ड भाल मन भावन"
        },
        {
          "id": 5,
          "first": "राजत मणि मुक्तन उर माला",
          "second": "स्वर्ण मुकुट शिर नयन विशाला"
        },
        {
          "id": 6,
          "first": "पुस्तक पाणि कुठार त्रिशूलं",
          "second": "मोदक भोग सुगन्धित फूलं"
        },
        {
          "id": 7,
          "first": "सुन्दर पीताम्बर तन साजित",
          "second": "चरण पादुका मुनि मन राजित"
        },
        {
          "id": 8,
          "first": "धनि शिव सुवन षडानन भ्राता",
          "second": "गौरी लालन विश्व-विख्याता"
        },
        {
          "id": 9,
          "first": "ऋद्धि-सिद्धि तव चंवर सुधारे",
          "second": "मुषक वाहन सोहत द्वारे"
        },
        {
          "id": 10,
          "first": "कहौ जन्म शुभ कथा तुम्हारी",
          "second": "अति शुची पावन मंगलकारी"
        },
        {
          "id": 11,
          "first": "एक समय गिरिराज कुमारी",
          "second": "पुत्र हेतु तप कीन्हा भारी"
        },
        {
          "id": 12,
          "first": "भयो यज्ञ जब पूर्ण अनूपा",
          "second": "तब पहुंच्यो तुम धरी द्विज रूपा"
        },
        {
          "id": 13,
          "first": "अतिथि जानी के गौरी सुखारी",
          "second": "बहुविधि सेवा करी तुम्हारी"
        },
        {
          "id": 14,
          "first": "अति प्रसन्न हवै तुम वर दीन्हा",
          "second": "मातु पुत्र हित जो तप कीन्हा"
        },
        {
          "id": 15,
          "first": "मिलहि पुत्र तुहि, बुद्धि विशाला",
          "second": "बिना गर्भ धारण यहि काला"
        },
        {
          "id": 16,
          "first": "गणनायक गुण ज्ञान निधाना",
          "second": "पूजित प्रथम रूप भगवाना"
        },
        {
          "id": 17,
          "first": "अस कही अन्तर्धान रूप हवै",
          "second": "पालना पर बालक स्वरूप हवै"
        },
        {
          "id": 18,
          "first": "बनि शिशु रुदन जबहिं तुम ठाना",
          "second": "लखि मुख सुख नहिं गौरी समाना"
        },
        {
          "id": 19,
          "first": "सकल मगन, सुखमंगल गावहिं",
          "second": "नाभ ते सुरन, सुमन वर्षावहिं"
        },
        {
          "id": 20,
          "first": "शम्भु, उमा, बहुदान लुटावहिं",
          "second": "सुर मुनिजन, सुत देखन आवहिं"
        },
        {
          "id": 21,
          "first": "लखि अति आनन्द मंगल साजा",
          "second": "देखन भी आये शनि राजा"
        },
        {
          "id": 22,
          "first": "निज अवगुण गुनि शनि मन माहीं",
          "second": "बालक, देखन चाहत नाहीं"
        },
        {
          "id": 23,
          "first": "गिरिजा कछु मन भेद बढायो",
          "second": "उत्सव मोर, न शनि तुही भायो"
        },
        {
          "id": 24,
          "first": "कहत लगे शनि, मन सकुचाई",
          "second": "का करिहौ, शिशु मोहि दिखाई"
        },
        {
          "id": 25,
          "first": "नहिं विश्वास, उमा उर भयऊ",
          "second": "शनि सों बालक देखन कहयऊ"
        },
        {
          "id": 26,
          "first": "पदतहिं शनि दृग कोण प्रकाशा",
          "second": "बालक सिर उड़ि गयो अकाशा"
        },
        {
          "id": 27,
          "first": "गिरिजा गिरी विकल हवै धरणी",
          "second": "सो दुःख दशा गयो नहीं वरणी"
        },
        {
          "id": 28,
          "first": "हाहाकार मच्यौ कैलाशा",
          "second": "शनि कीन्हों लखि सुत को नाशा"
        },
        {
          "id": 29,
          "first": "तुरत गरुड़ चढ़ि विष्णु सिधायो",
          "second": "काटी चक्र सो गज सिर लाये"
        },
        {
          "id": 30,
          "first": "बालक के धड़ ऊपर धारयो",
          "second": "प्राण मन्त्र पढ़ि शंकर डारयो"
        },
        {
          "id": 31,
          "first": "नाम गणेश शम्भु तब कीन्हे",
          "second": "प्रथम पूज्य बुद्धि निधि, वर दीन्हे"
        },
        {
          "id": 32,
          "first": "बुद्धि परीक्षा जब शिव कीन्हा",
          "second": "पृथ्वी कर प्रदक्षिणा लीन्हा"
        },
        {
          "id": 33,
          "first": "चले षडानन, भरमि भुलाई",
          "second": "रचे बैठ तुम बुद्धि उपाई"
        },
        {
          "id": 34,
          "first": "चरण मातु-पितु के धर लीन्हें",
          "second": "तिनके सात प्रदक्षिण कीन्हें"
        },
        {
          "id": 35,
          "first": "धनि गणेश कही शिव हिये हरषे",
          "second": "नभ ते सुरन सुमन बहु बरसे"
        },
        {
          "id": 36,
          "first": "तुम्हरी महिमा बुद्धि बड़ाई",
          "second": "शेष सहसमुख सके न गाई"
        },
        {
          "id": 37,
          "first": "मैं मतिहीन मलीन दुखारी",
          "second": "करहूं कौन विधि विनय तुम्हारी"
        },
        {
          "id": 38,
          "first": "भजत रामसुन्दर प्रभुदासा",
          "second": "जग प्रयाग, ककरा, दुर्वासा"
        },
        {
          "id": 39,
          "first": "अब प्रभु दया दीना पर कीजै",
          "second": "अपनी शक्ति भक्ति कुछ दीजै"
        }
      ]
    },
    {
      "id": "closing",
      "verses": [
        {
          "id": 40,
          "first": "श्री गणेश यह चालीसा, पाठ करै कर ध्यान",
          "second": "नित नव मंगल गृह बसै, लहे जगत सन्मान"
        },
        {
          "id": 41,
          "first": "सम्बन्ध अपने सहस्र दश, ऋषि पंचमी दिनेश",
          "second": "पूरण चालीसा भयो, मंगल मूर्ती गणेश"
        }
      ]
    }
  ]
}
