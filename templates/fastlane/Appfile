# fastlane `eval`s this file rather than loading it, so there is no __FILE__ to
# resolve against and `require_relative` dies with "cannot infer basepath" —
# taking the whole lane with it. The CWD differs between the two files that hit
# this (CredentialsManager chdirs into fastlane/ for the Appfile; deliver does
# not chdir at all for the Deliverfile), so neither Dir.pwd nor a fixed relative
# path is safe on its own. Walk up for the one file we know the name of.
project_root = Dir.pwd
until File.exist?(File.join(project_root, "fastlane", "project.rb")) || project_root == "/"
  project_root = File.dirname(project_root)
end
require File.join(project_root, "fastlane", "project")
app_identifier project_config["app"]["bundleId"]
apple_id ENV["FASTLANE_APPLE_ID"]
itc_team_id ENV["FASTLANE_ITC_TEAM_ID"]
team_id "{{TEAM_ID}}"
