# Deliverfile — App Store Connect metadata configuration
# Docs: https://docs.fastlane.tools/actions/deliver/

# fastlane `eval`s this file rather than loading it, so there is no __FILE__ to
# resolve against and `require_relative` dies with "cannot infer basepath" —
# taking the whole lane with it. The CWD differs between the two files that hit
# this (CredentialsManager chdirs into fastlane/ for the Appfile; deliver does
# not chdir at all for the Deliverfile), so neither Dir.pwd nor a fixed relative
# path is safe on its own. Walk up for the one file we know the name of.
project_root = Dir.pwd
until File.exist?(File.join(project_root, "fastlane", "project.rb")) || project_root == "/"
  project_root = File.dirname(project_root)
end
require File.join(project_root, "fastlane", "project")

# ── Identity ──────────────────────────────────────────────────────────────
app_identifier project_config["app"]["bundleId"]

# ── Languages ─────────────────────────────────────────────────────────────
# Store-listing locales. deliver activates missing ones and fills them from
# fastlane/metadata/<locale>/. Locales without their own screenshots fall
# back to the primary locale's screenshots on the store.
# NOTE: the store locale list is Apple's fixed set — check before adding
# (e.g. Hindi is supported, Gujarati is not).
languages(project_config["store"]["locales"])

# ── Paths ─────────────────────────────────────────────────────────────────
# Resolved from the WORKING DIRECTORY (repo root), not the fastlane folder —
# unprefixed "./metadata" silently points at nothing and deliver no-ops
# with success.
metadata_path    "./fastlane/metadata"
screenshots_path "./fastlane/screenshots"

# ── Categories ────────────────────────────────────────────────────────────
# Education, not Entertainment. Entertainment is one of the most contested
# categories on the store and browse placement there is unwinnable for a new
# app; Education is where a parent looks for a young child, and it is honest
# here — the crayons are named for the colours a child is learning to say.
#
# Deliberately NOT the Kids category: it forbids third-party data collection
# without verifiable parental consent, and this app ships Firebase Analytics
# and Crashlytics. Staying out of Kids is also why the share sheet needs no
# parental gate.
primary_category   "{{PRIMARY_CATEGORY}}"
secondary_category "{{SECONDARY_CATEGORY}}"

# ── Pricing ───────────────────────────────────────────────────────────────
# Managed in App Store Connect directly — Apple removed the pricing
# attributes from the API endpoint deliver used (price_tier breaks every
# push with Spaceship::UnexpectedResponse).

# ── Submission answers ────────────────────────────────────────────────────
# The three questions App Store Connect asks at submission. Answered here so
# they are the same on every push and reviewable in git, rather than clicked
# through from memory once a release is already in flight.
submission_information(
  # ITSAppUsesNonExemptEncryption is already NO in the build settings; this is
  # the same answer at the submission layer.
  export_compliance_uses_encryption: false,
  # The artwork is the app's own. If that ever stops being true this is the
  # line that has to change, and it is a legal answer rather than a technical
  # one — see fastlane/metadata/review_reply.txt item 7.
  content_rights_contains_third_party_content: false,
  # No IDFA: no advertising SDK is linked and AdSupport is not in the binary.
  add_id_info_uses_idfa: false
)

# ── Age rating ────────────────────────────────────────────────────────────
# The questionnaire, from a file rather than from memory. It used to be
# clicked through in App Store Connect, where nothing recorded what had been
# answered — and those answers are what decide the 4+ rating this whole
# listing is built on. app_rating_config.json carries the reasoning beside
# each one, including why kidsAgeBand is deliberately absent.
#
# It sits beside metadata/ rather than inside it: `generate_metadata` turns
# every *.json in metadata/ into a locale directory, so a non-locale file put
# there becomes a directory deliver then rejects as an unsupported language.
app_rating_config_path "./fastlane/app_rating_config.json"

# ── Precheck ──────────────────────────────────────────────────────────────
# `precheck_include_in_app_purchases false` sat here for a long time with
# nothing ever running precheck — a configured option for a tool that was
# never invoked. It runs before submission now: it reads the finished listing
# the way App Review does and catches the 2.3.x rejections that are cheap to
# avoid and expensive to earn — placeholder text left in a description, a
# mention of another platform, a URL that 404s.
#
# API-key auth cannot scan IAPs (fastlane limitation), and this app has none.
precheck_include_in_app_purchases false
run_precheck_before_submit true
precheck_default_rule_level :warn

# ── Copyright ─────────────────────────────────────────────────────────────
copyright "© {{YEAR}} {{OWNER_NAME}}"

# ── URLs ──────────────────────────────────────────────────────────────────
# support/marketing/privacy URLs live in metadata/<locale>.json — NEVER set
# them here as plain strings: deliver treats URL fields as per-locale
# hashes and aborts with "'support_url' value must be a Hash!" (see
# MIGRATE.md gotchas).

# ── Screenshots ───────────────────────────────────────────────────────────
# Managed exclusively by the `screenshots` lane via sync_screenshots.
# No overwrite flag — the legacy overwrite path double-uploads.

# ── Submission ────────────────────────────────────────────────────────────
submit_for_review false   # submission stays a human step

# automatic_release / phased_release are deliberately NOT set.
#
# deliver only sends releaseType when automatic_release is non-nil, and App
# Store Connect rejects the whole metadata PATCH with
#   "The attribute 'releaseType' can not be modified"
# whenever the version has no build attached yet — which is every first
# release, and every version created before its build is uploaded. The push
# fails even when the value being sent matches what is already there.
#
# phased_release is worse: Apple does not offer phased release for an app's
# FIRST version at all, only for updates.
#
# Set them in App Store Connect at submission time, or re-enable here once
# the version has a build attached.

# ── Options ───────────────────────────────────────────────────────────────
skip_binary_upload true    # Xcode Cloud owns the build
force              true    # no interactive HTML preview
