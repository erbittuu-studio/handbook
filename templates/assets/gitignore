# PES standard .gitignore — macOS, Xcode/Swift, Firebase, data.
# Delete sections that don't apply; add project entries at the bottom.

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode / Swift
DerivedData/
build/
*.xcuserstate
xcuserdata/
.swiftpm/
.build/

# Signing & secrets — never committed, no exceptions
*.p8
*.p12
*.mobileprovision
*.provisionprofile
*.certSigningRequest
.env
.env.*

# Firebase (if used)
.firebase/
firebase-debug.log
ui-debug.log

# Every dependency is a local package, so a resolved file should never appear.
Package.resolved

# Generated by local builds. A stale one makes Xcode Cloud onboarding fail
# trying to match a product that no longer exists.
*.xcodeproj/xcshareddata/xcodecloud/




# update.sh scratch file for .pes-sync-manifest — the manifest itself is
# tracked, this temp swap file is not.
.pes-sync-manifest.new

# Project

# Screenshots taken by App/Packages/PES/ci/screenshot_sweep.py, and its build.
.screenshots/
