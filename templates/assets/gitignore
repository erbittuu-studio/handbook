# PES standard .gitignore — macOS, Xcode/Swift, Ruby/fastlane, Firebase, data.
# Delete sections that don't apply; add project entries at the bottom.

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode / Swift
DerivedData/
build/
*.xcuserstate
xcuserdata/
.swiftpm/
.build/

# Signing & secrets — never committed, no exceptions
*.p8
*.p12
*.mobileprovision
*.provisionprofile
*.certSigningRequest
.env
.env.*
!.env.example

# Ruby / fastlane (screenshots and metadata ARE committed — they're content)
vendor/
.bundle/
fastlane/test_output/
fastlane/README.md

# Firebase (if used)
.firebase/
firebase-debug.log
ui-debug.log

# Every dependency is a local package, so a resolved file should never appear.
Package.resolved

# fastlane build products — regenerated in CI from metadata/<locale>.json
fastlane/metadata/*/
fastlane/report.xml

# Generated by local builds. A stale one makes Xcode Cloud onboarding fail
# trying to match a product that no longer exists (MIGRATE.md gotchas).
*.xcodeproj/xcshareddata/xcodecloud/

# Xcode Cloud workflow backups — scripts/ci/xcode_cloud_workflow.rb writes one
# before every edit so a wrong result is undoable. They are a local safety net,
# not a record: the intended setting is the flag you ran, and that is in git.
xcode-cloud-*.json

# CI-only markers: main.yml's store-push jobs write one per locale so an
# unchanged listing or screenshot set is not re-sent on every merge.
.asc-pushed-*

# Staged Firebase Hosting site — built by Hosting/build.py, never committed.
# Every app using the Hosting seed produces this the same way.
Hosting/Content/

# update.sh scratch file for .pes-sync-manifest — the manifest itself is
# tracked, this temp swap file is not.
.pes-sync-manifest.new

# Project
